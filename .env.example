# Секрет для JWT (обязательно смените в продакшене)
JWT_SECRET=EObZWhd2IJ+bGTEL4hLyVCF7h10T3nj+6yhpSFBctAREXB+65KWjbmHmHbFyTSkG

# Куда слать все служебные письма (регистрации, заказы, чат, правки в админке).
# Несколько адресов: через запятую или точку с запятой.
NOTIFY_EMAIL=traceur95@mail.ru

# 0 — не слать письмо на каждое сообщение в чате (остальные уведомления как обычно)
MAIL_NOTIFY_CHAT=1

# Первый админ (создаётся только если таблица admins пуста)
ADMIN_EMAIL=traceur95@mail.ru
ADMIN_PASSWORD=1234567890

# SMTP (без этого письма не уходят — текст дублируется в лог Railway)
# На Railway часто ошибка ENETUNREACH к IPv6 у smtp.mail.ru — по умолчанию соединение идёт через IPv4.
# Отключить принудительный IPv4: SMTP_PREFER_IPV4=0
#
# Вариант A — Mail.ru (пароль приложения: Настройки → Безопасность → Пароли приложений)
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=traceur95@mail.ru
# SMTP_PASS=ваш_пароль_приложения
# SMTP_FROM=traceur95@mail.ru
#
# Вариант B — тот же ящик, порт 587 (STARTTLS): SMTP_PORT=587, SMTP_SECURE=false
#
# Вариант C — без SMTP_HOST, через пресет nodemailer:
# SMTP_SERVICE=Mail.ru
# SMTP_USER=traceur95@mail.ru
# SMTP_PASS=ваш_пароль_приложения
# SMTP_FROM=traceur95@mail.ru
